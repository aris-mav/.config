# unused and annoying
unbind-key Space

# Remap prefix
unbind-key C-b
set-option -g prefix C-a
bind-key C-a send-prefix

# Split on current dir
bind % split-window -h -c "#{pane_current_path}"
bind '"' split-window -v -c "#{pane_current_path}"
bind -n M-n run-shell "~/.config/tmux/scripts/auto_split.sh"

bind -n M-N neww

# Fullscreen pane
bind -n M-z resize-pane -Z ""
 
bind C-f display-popup -d "#{pane_current_path}" \
         -S fg=green -b rounded -h 75% -w 75% \
         -E "fish"

# Kill pane without confirmation prompt
bind-key X kill-pane
